{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miniforge3d.local/contracts/manifest.schema.json",
  "title": "MiniForge 3D Step Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "step",
    "status",
    "inputs",
    "outputs",
    "started_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "step": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["pending", "running", "completed", "failed", "skipped", "cancelled"]
    },
    "tool_versions": { "type": "object" },
    "effective_config": { "type": "object" },
    "inputs": { "type": "array" },
    "outputs": { "type": "array" },
    "input_fingerprint": { "type": "string" },
    "config_fingerprint": { "type": "string" },
    "statistics": { "type": "object" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "error": { "type": ["object", "null"] },
    "started_at": { "type": "string" },
    "finished_at": { "type": ["string", "null"] },
    "duration_seconds": { "type": ["number", "null"], "minimum": 0 }
  }
}

